    "peerDependencies": {
        "@softspring/cms-bundle": "*",
        "@softspring/translatable-bundle": "*"
    },
    "devDependencies": {
        "@eslint/js": "^9.11.1",
        "eslint": "^8.57.1",
        "globals": "^15.9.0",
        "@softspring/cms-bundle": "file:./../vendor/softspring/cms-bundle",
        "@softspring/collection-form-type": "file:./../vendor/softspring/collection-form-type",
        "@softspring/media-bundle": "file:./../vendor/softspring/media-bundle",
