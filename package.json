        "@softspring/translatable-bundle": "file:./../vendor/softspring/translatable-bundle"
    },
    "symfony": {
        "importmap": {
            "@softspring/cms-translation-plugin/scripts/admin-translations.js": {
                "path": "assets/dist/scripts/admin-translations.js"
