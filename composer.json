{
    "name": "softspring/cms-translation-plugin",
    "description": "A translation extension for softspring cms",
    "type": "sfs-cms-plugin",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "softspring/cms-bundle": "^6.0@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "softspring/cms-sections-plugin": "^6.0@dev"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsTranslationPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsTranslationPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "google/cloud-translate": "To use Google Cloud Translation API"
    }
}
