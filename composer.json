{
    "name": "softspring/cms-translation-plugin",
    "description": "A translation extension for softspring cms",
    "type": "sfs-cms-plugin",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "softspring/cms-bundle": "^5.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.64.*",
        "google/cloud-translate": "^1.17",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^1.0",
        "symfony/translation": "^5.4|^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsTranslationPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsTranslationPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "google/cloud-translate": "To use Google Cloud Translation API"
    }
}
