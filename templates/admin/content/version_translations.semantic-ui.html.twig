{% trans_default_domain 'sfs_cms_contents' %}

{% extends '@SfsCms/admin_layout_semantic.html.twig' %}

{% form_theme form
    '@SyliusUi/Form/theme.html.twig'
    '@SfsCms/forms/routes_theme_semantic.html.twig'
    '@SfsCms/forms/types_theme_semantic.html.twig'
    '@SfsCmsTranslationPlugin/forms/translation_form_theme.semantic-ui.html.twig'
%}

{% block title %}{{ ('admin_'~content_type~'.translations.meta.title')|trans({'%name%':content_entity.name}) }}{% endblock %}

{% block header_title %}{{ ('admin_'~content_type~'.translations.title')|trans({'%name%':content_entity.name, '%versionNumber%': prev_version.versionNumber|default('')}) }}{% endblock %}
{% block header_subtitle %}Manage your page{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <a class="section"
       href="{{ url('sfs_cms_admin_content_'~content_type~'_list') }}">{{ ('admin_'~content_type~'.list.breadcrumb')|trans }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section" href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':entity}) }}">{{ ('admin_'~content_type~'.read.breadcrumb')|trans({'%name%': entity.name}) }}</a>
    <i class="right chevron icon divider"></i>
    <a class="section active">{{ ('admin_'~content_type~'.translations.breadcrumb')|trans({'%name%':content_entity.name}) }}</a>
{% endblock breadcrums_content %}

{% block content %}
    {% include ['@content/'~content_type~'/admin/_content_tabs.html.twig', '@SfsCms/admin/content/_content_tabs.html.twig']  with {'current':'translations', 'content':content_entity, 'entity':version_entity} %}
    <div class="ui bottom attached active tab segment">
        <div class="ui right aligned grid clearing" style="margin-bottom: 0">
            <div class="ui buttons column">
                {% if not content_config.admin.version_translations_import.is_granted or is_granted(content_config.admin.version_translations_import.is_granted, entity) %}
                    <a class="ui blue labeled icon button"
                       href="{{ url('sfs_cms_admin_content_'~content_type~'_translations_import', {'content':entity, 'back':'translations', 'version':prev_version.id}) }}">
                        <i class="icon upload"></i>
                        {{ ('admin_'~content_type~'.translations.actions.import_translations.link')|trans }}
                    </a>
                {% else %}
                    <a class="ui blue labeled icon button disabled" href="">
                        <i class="icon upload"></i>
                        {{ ('admin_'~content_type~'.translations.actions.import_translations.link')|trans }}
                    </a>
                {% endif %}


                {% if not content_config.admin.version_translations_export.is_granted or is_granted(content_config.admin.version_translations_export.is_granted, entity) %}
                    {% if content_config.admin.version_translations_export.formats|length > 1 %}
{#                        <div class="btn-group">#}
{#                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" title="Export"#}
{#                                    data-bs-toggle="dropdown" aria-expanded="false">#}
{#                                <i class="icon download"></i>#}
{#                                {{ ('admin_'~content_type~'.translations.actions.export_translations.link')|trans }}#}
{#                            </button>#}
{#                            <ul class="dropdown-menu dropdown-menu-end">#}
{#                                {% for format in content_config.admin.version_translations_export.formats %}#}
{#                                    <li><a class="dropdown-item"#}
{#                                           href="{{ url('sfs_cms_admin_content_'~content_type~'_translations_export_all', {'content':entity, 'back':'translations', 'format': format, 'version':prev_version.id}))}}">{{ ('admin_page.translations.export.formats.'~format)|trans }}</a>#}
{#                                    </li>#}
{#                                {% endfor %}#}
{#                            </ul>#}
{#                        </div>#}
                        {# TODO SHOW EXPORT DROPDOWN #}
                    {% else %}
                        {% set format = content_config.admin.version_translations_export.formats|first %}
                        <a class="ui red labeled icon button"
                           href="{{ url('sfs_cms_admin_content_'~content_type~'_translations_export_all', {'content':entity, 'back':'translations', 'format': format, 'version':prev_version.id}) }}"
                           title="{{ ('admin_page.translations.export.formats.'~format)|trans }}">
                            <i class="icon download"></i>
                            {{ ('admin_'~content_type~'.translations.actions.export_translations.link')|trans }}
                        </a>
                    {% endif %}
                {% else %}
                    <a class="ui red labeled icon button disabled" href="">
                        <i class="icon download"></i>
                        {{ ('admin_'~content_type~'.translations.actions.export_translations.link')|trans }}
                    </a>
                {% endif %}
            </div>
        </div>

        {% if app.request.attributes.has('_translations_imported') %}
            <div class="ui green message" role="alert">
                Translations imported successfully, review them and <strong>save a new version to apply changes</strong>.
            </div>
        {% endif %}

        {% for warning in globalImportWarnings|default %}
            <div class="ui orange message" role="alert">
                {{ warning }}
            </div>
        {% endfor %}

        {{ form_start(form,{'attr':{'class':'ui form clearing'}}) }}
        <table class="ui table">
            <tr>
                <th style="width: 10%">&nbsp;</th>
                {% for i, locale in content_entity.locales %}
                    {% set color = (loop.first ? 'ui message info' : 'ui message') %}
                    {% set currentLocale = locale %}
                    <th style="height: 50px" {{ loop.first ? 'data-default-locale-trans='~locale : 'data-locale-trans='~locale }} class="{{ loop.index > 2 ? 'd-none hidden' :'' }}">
                        <div
                            class="{{ color }} ui center aligned text-{{ colors[i]|default('dark') }}">

                            {% if content_entity.locales|length > 2 and not loop.first %}

                                {% if sfs_cms_translation.api.driver|default(false) %}
                                    <button class="ui left floated icon button" type="button"
                                            data-translate-all-target-locale="{{ locale }}" title="Translate all">
                                        {% if sfs_cms_translation.api.driver|default('none') == 'google' %}
                                            <i class="language icon blue"></i>
                                        {% endif %}
                                    </button>
                                {% endif %}

                                <div class="ui floated simple dropdown item" tabindex="0">
                                    <i class="ui language icon big"></i> {{ currentLocale }}
                                    <i class="dropdown icon" tabindex="0"><div class="menu" tabindex="-1"></div></i>
                                    <div class="menu" tabindex="-1">
                                        {% for i, locale in content_entity.locales %}
                                            {% if locale != currentLocale and  not loop.first %}
                                                <div class="item" data-locale-trans-toggler="{{ locale }}">
                                                    <i class="language icon"></i>
                                                    {{ locale }}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <span>
                                    <i class="language icon big"></i>
                                    {{ locale }}
                                </span>
                            {% endif %}

                            {% if not content_config.admin.version_translations_export.is_granted or is_granted(content_config.admin.version_translations_export.is_granted, entity) %}
                                {% if content_config.admin.version_translations_export.formats|length > 1 %}
{#                                    <div class="btn-group">#}
{#                                        <button type="button" class="btn btn-link dropdown-toggle"#}
{#                                                title="Export"#}
{#                                                data-bs-toggle="dropdown" aria-expanded="false">#}
{#                                            <i class="icon download"></i>#}
{#                                        </button>#}
{#                                        <ul class="dropdown-menu dropdown-menu-end">#}
{#                                            {% for format in content_config.admin.version_translations_export.formats %}#}
{#                                                <li><a class="dropdown-item"#}
{#                                                       href="{{ url('sfs_cms_admin_content_'~content_type~'_translations_export', {'content':entity, 'back':'translations', 'target':locale, 'format': format, 'version':prev_version.id}))}}">{{ ('admin_page.translations.export.formats.'~format)|trans }}</a>#}
{#                                                </li>#}
{#                                            {% endfor %}#}
{#                                        </ul>#}
{#                                    </div>#}
                                    {# TODO SHOW EXPORT DROPDOWN #}
                                {% else %}
                                    {% set format = content_config.admin.version_translations_export.formats|first %}
                                    <a class="ui right floated icon button"
                                       href="{{ url('sfs_cms_admin_content_'~content_type~'_translations_export', {'content':entity, 'back':'translations', 'target':locale, 'format': format, 'version':prev_version.id}) }}"
                                       title="{{ ('admin_page.translations.export.formats.'~format)|trans }}">
                                        <i class="icon download"></i>
                                    </a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </th>
                {% endfor %}
            </tr>

            {% set module_type = '' %}
            {% set module = '' %}
            {% for field in form|filter( (field) => field.vars.attr['data-module']|default(false) ) %}
                {% if field.vars.attr['data-module-type'] != module_type or field.vars.attr['data-module'] != module %}
                    {% set module_type = field.vars.attr['data-module-type'] %}
                    {% set module = field.vars.attr['data-module'] %}
                    <tr>
                        <td colspan="50" class="ui header active">
                            <strong>
                                {{ field.vars.attr['data-module']|split(':')|join(' > ') }}
                                {% if module_type != 'seo' %}
                                    &gt; {{ (module_type~'.label')|trans({}, 'sfs_cms_modules') }}
                                {% endif %}
                            </strong>
                        </td>
                    </tr>
                {% endif %}

                <tr>
                    {#<td>{{ field.vars.name }}</td>#}
                    <td>
                        {% if module_type == 'seo' %}
                            {{ ('admin_page.form.seo.'~field.vars.attr['data-module-field']~'.label')|trans({}, 'sfs_cms_contents') }}
                        {% else %}
                            {{ (module_type~'.form.'~field.vars.attr['data-module-field']~'.label')|trans({}, 'sfs_cms_modules') }}
                        {% endif %}
                        {{ form_widget(field._trans_id) }}
                        {{ form_widget(field._default) }}
                    </td>

                    {% for locale in content_entity.locales %}
                        <td {{ loop.first ? 'data-default-locale-trans='~locale : 'data-locale-trans='~locale }} class="{{ loop.index > 2 ? 'd-none hidden' :'' }}">
                            {{ form_widget(field.offsetGet(locale)) }}

                            {% for warning in fieldImportWarnings[field.vars.name][locale]|default %}
                                <div class="ui orange message" role="alert">
                                    {{ warning }}
                                </div>
                            {% endfor %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>

        {{ form_rest(form) }}

        <div class="ui hidden divider"></div>
        <div class="ui buttons">
            <button class="ui labeled icon primary button" type="submit"><i class="save icon"></i> {{ ('admin_'~content_type~'.translations.actions.save.button')|trans }}</button>
            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':entity}) }}" class="ui button">{{ ('admin_'~content_type~'.translations.actions.cancel.button')|trans }}</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock content %}
